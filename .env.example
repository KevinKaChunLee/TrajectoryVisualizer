# Sample .env for TrajectoryVisualizer — copy to `.env` and fill in.
# Used by scripts/step_labeler.py (LLM-based per-step classifier).
# `.env` is gitignored; keep your real API key out of version control.

# --- Required -------------------------------------------------------------

# OpenAI-compatible API base URL.
# Examples:
#   OpenAI:       https://api.openai.com/v1
#   OpenRouter:   https://openrouter.ai/api/v1
#   Anthropic:    https://api.anthropic.com
#   Self-hosted:  http://localhost:8000/v1
LABEL_BASE_URL=https://api.openai.com/v1

# API key for the provider above.
LABEL_API_KEY=sk-xxxxx-xxxxx

# Model identifier understood by the provider.
# Examples: gpt-4o-mini, gpt-4o, claude-3-5-sonnet-20241022, glm-4.6
LABEL_MODEL=gpt-5.4

# --- Optional -------------------------------------------------------------

# Provider flavor: "openai" (default, OpenAI-compatible chat/completions)
# or "anthropic" (native Anthropic messages API).
LABEL_PROVIDER=openai

# Sampling temperature (default 0.3). Lower → more deterministic labels.
LABEL_TEMPERATURE=0.3

# Max response tokens per step (default 1024).
LABEL_MAX_TOKENS=1024
